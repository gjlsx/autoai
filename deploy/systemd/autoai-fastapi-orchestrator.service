[Unit]
Description=AutoAI FastAPI Cloud Orchestrator
After=network.target

[Service]
Type=simple
User=lianping1230
WorkingDirectory=/home/lianping1230/autoai
EnvironmentFile=/home/lianping1230/autoai/.env
ExecStart=/home/lianping1230/autoai/.venv/bin/uvicorn cloud_orchestrator.main:app --host 0.0.0.0 --port 18080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
